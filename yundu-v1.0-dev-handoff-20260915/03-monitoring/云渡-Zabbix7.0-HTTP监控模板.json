    "templates": [
      {
        "uuid": "fe54f10da2c55152bea82d519778e75e",
        "template": "Yundu by HTTP",
        "name": "云渡文件交换平台 by HTTP",
        "description": "云渡v1监控契约；Zabbix 7.0 HTTP采集，无终端Agent。导入后配置URL、秘密TOKEN及来源白名单。模板为交付设计，需在实际Zabbix 7.0导入联调。",
        "groups": [
          {
            "name": "Templates/Yundu"
          }
        ],
        "items": [
          {
            "uuid": "3b358c3557145042bfd3cb2f590fb173",
            "name": "云渡：读取HTTP监控快照",
            "type": "HTTP_AGENT",
            "key": "yundu.metrics.raw",
            "delay": "30s",
            "history": "1d",
            "value_type": "TEXT",
            "trends": "0",
            "url": "{$YUNDU.URL}/api/v1/monitoring/zabbix",
            "http_proxy": "{$YUNDU.HTTP.PROXY}",
            "timeout": "10s",
            "status_codes": "200",
            "follow_redirects": "NO",
            "verify_peer": "YES",
            "verify_host": "YES",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {$YUNDU.TOKEN}"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "preprocessing": [
              {
                "type": "JAVASCRIPT",
                "parameters": [
                  "var d=JSON.parse(value); if(d.schema_version!==1) throw \"Unsupported metrics schema\"; var keys=[\"snapshot_valid\", \"snapshot_updated_at\", \"open_policy_breach_incidents\", \"open_integrity_incidents\", \"cross_zone_denied_5m\", \"unauthorized_download_denied_5m\", \"text_denied_5m\", \"size_denied_5m\", \"quota_denied_5m\", \"resource_busy_5m\", \"max_user_upload_attempts_5m\", \"max_user_download_starts_5m\", \"max_user_upload_bytes_1h\", \"max_user_download_bytes_1h\", \"active_uploads\", \"active_downloads\", \"active_copies\", \"audit_aggregation_lag_seconds\"]; for(var i=0;i<keys.length;i++){var v=d[keys[i]]; if(typeof v!==\"number\" || !isFinite(v) || v<0 || Math.floor(v)!==v) throw \"Missing or invalid metric: \"+keys[i];} return JSON.stringify(d);"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "health"
              }
            ],
            "triggers": [
              {
                "uuid": "38ca6a7a57235874bcc6ac59e0260b67",
                "name": "云渡：监控接口无有效数据",
                "expression": "nodata(/Yundu by HTTP/yundu.metrics.raw,3m)=1",
                "priority": "HIGH"
              }
            ]
          },
          {
            "uuid": "5434f7f055695ecba949f7de73f188a3",
            "name": "云渡：指标窗口已完整建立",
            "type": "DEPENDENT",
            "key": "yundu.snapshot_valid",
